modules = ["nodejs-24", "postgresql-17"]
entrypoint = "artifacts/api-server/src/index.ts"
run = "corepack pnpm --filter @workspace/api-server run dev"

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "pnpm-lock.yaml"]

[deployment]
deploymentTarget = "cloudrun"
build = "corepack pnpm install --frozen-lockfile --registry=https://registry.npmjs.org/ && corepack pnpm run build:web && corepack pnpm run build:api"
run = "corepack pnpm run start:api"

[env]
HOST = "0.0.0.0"

[[ports]]
localPort = 8080
externalPort = 80
