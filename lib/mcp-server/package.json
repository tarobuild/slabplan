{
  "name": "@workspace/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "workspace": "./src/http-transport.ts",
      "types": "./dist/http-transport.d.ts",
      "default": "./dist/http-transport.js"
    },
    "./stdio": {
      "workspace": "./src/stdio.ts",
      "types": "./dist/stdio.d.ts",
      "default": "./dist/stdio.js"
    }
  },
  "bin": {
    "cadstone-mcp": "./bin/cadstone-mcp.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stdio": "MCP_STDIO_DIRECT=1 tsx ./src/stdio.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "~5.9.2"
  }
}
